# Copia este archivo a .env.docker. Completa los cuatro secretos antes de levantar los servicios.
# No subas .env.docker. Usa una contraseña URL-safe para PostgreSQL (por ejemplo, base64url).
POSTGRES_PASSWORD=
PUERTO_POSTGRES_LOCAL=5433
DATABASE_URL=postgres://supera:${POSTGRES_PASSWORD}@db:5432/supera_paes

# Docker Compose fija NODE_ENV=development para conservar los proveedores locales.
NODE_ENV=development
PORT=3000
DATABASE_SSL=false
JWT_SECRETO_CONSOLA=
JWT_SECRETO_APP=
CLAVE_CODIGO_CORREO=
CORS_ORIGENES=http://localhost:8080
URL_CONSOLA=http://localhost:8080
PROVEEDOR_IA=simulado
# Las claves vacías conservan la ejecución local sin red hacia proveedores de IA.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
PROVEEDOR_CORREO=consola
# SMTP queda desactivado mientras el proveedor sea consola. Para Mailpit o un servidor real,
# completa estos valores como indica el README; nunca guardes aquí credenciales reales.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=
SMTP_TIMEOUT_MS=10000
PROVEEDOR_PAGOS=simulado
SEMILLAS_OMITIDAS=

# Vite inserta esta URL pública en los archivos de la consola; nunca coloques secretos VITE_.
VITE_API_URL=http://localhost:3000
