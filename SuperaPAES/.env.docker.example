# Copia este archivo a .env.docker. Completa los cuatro secretos antes de levantar los servicios.
# No subas .env.docker. Usa una contraseña URL-safe para PostgreSQL (por ejemplo, base64url).
POSTGRES_PASSWORD=
PUERTO_POSTGRES_LOCAL=5433
DATABASE_URL=postgres://supera:${POSTGRES_PASSWORD}@db:5432/supera_paes

# Docker Compose fija NODE_ENV=development para conservar los proveedores locales.
NODE_ENV=development
PORT=3000
DATABASE_SSL=false
JWT_SECRETO_CONSOLA=
JWT_SECRETO_APP=
CLAVE_CODIGO_CORREO=
CORS_ORIGENES=http://localhost:8080
URL_CONSOLA=http://localhost:8080
PROVEEDOR_IA=simulado
PROVEEDOR_CORREO=consola
PROVEEDOR_PAGOS=simulado
SEMILLAS_OMITIDAS=

# Vite inserta esta URL pública en los archivos de la consola; nunca coloques secretos VITE_.
VITE_API_URL=http://localhost:3000
