{
  "name": "supera-paes",
  "private": true,
  "description": "Plataforma de práctica para la PAES: API, consola web y app de estudiantes.",
  "type": "module",
  "workspaces": [
    "api",
    "consola"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint --workspaces && prettier --check .",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "formatear": "prettier --write .",
    "codigo-muerto": "knip",
    "circulares": "madge --circular --extensions ts --ts-config api/tsconfig.json api/servidor.ts api/app.ts api/db/scripts && madge --circular --extensions ts,tsx --ts-config consola/tsconfig.json consola/src/main.tsx",
    "duplicacion": "jscpd",
    "cobertura": "npm run cobertura --workspaces",
    "revisar-secretos": "secretlint \"**/*\""
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "madge": "^8.0.0",
    "prettier": "^3.10.1",
    "secretlint": "^13.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
