# Copia este archivo como consola/.env.local. Solo variables públicas: nunca pongas claves aquí,
# porque todo lo que empieza con VITE_ queda dentro del código que descarga el navegador.
VITE_API_URL=http://localhost:3000
# Botones de la página de invitación (/invitar/<código>, RN-33): durante la prueba cerrada, el enlace de
# inscripción de Google Play y el enlace público de TestFlight. Vacíos, la página dice «Pronto en».
VITE_ENLACE_GOOGLE_PLAY=
VITE_ENLACE_APP_STORE=
