# Copia este archivo como api/.env y completa los valores. Nunca subas api/.env al repositorio.
# Con NODE_ENV=production la API no arranca con proveedores de desarrollo: exige
# PROVEEDOR_IA=deepseek|gemini, PROVEEDOR_CORREO=smtp y PROVEEDOR_PAGOS=tiendas.
# Con todos los proveedores en simulado/consola, la API arranca solo con DATABASE_URL, los dos
# secretos JWT y PORT. Los parámetros de negocio (cupos, bonos, topes, plazos) no van aquí:
# viven en la tabla contenido.configuracion.

NODE_ENV=development
PORT=3000

# PostgreSQL 18 instalado en el equipo, puerto 5432.
# Valor de ejemplo (CAMBIAR por la clave de tu PostgreSQL local). secretlint-disable-next-line
DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5432/supera_paes
# true en Neon u otro servicio con TLS.
DATABASE_SSL=false
# Semillas que npm run semillas y migrar:produccion no cargan, separadas por comas. En la base
# publicada: 003_documentos_legales.sql, hasta que un docente o el cliente revise el texto (RN-30).
# SEMILLAS_OMITIDAS=003_documentos_legales.sql

# Orígenes permitidos (solo la consola web; la app móvil no usa CORS), separados por comas.
CORS_ORIGENES=http://localhost:5173

# Secretos distintos, de al menos 32 caracteres. Genera cada uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO_CONSOLA=
JWT_SECRETO_APP=

# IA: simulado | deepseek | gemini. Solo se exige la clave del proveedor elegido.
PROVEEDOR_IA=simulado
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Correo: consola (no envía nada) | smtp. Mailpit es opcional en local (SMTP 1025, web http://localhost:8025).
PROVEEDOR_CORREO=consola
SMTP_HOST=localhost
SMTP_PORT=1025
CORREO_REMITENTE="Supera PAES <no-responder@supera-paes.local>"

# Pagos: simulado (desarrollo y pruebas) | tiendas (Google Play Billing y App Store).
# Con tiendas, todas las variables siguientes son obligatorias.
PROVEEDOR_PAGOS=simulado
GOOGLE_PLAY_PAQUETE=cl.superapaes.app
# Ruta del archivo o contenido JSON de la cuenta de servicio de la Google Play Developer API.
GOOGLE_PLAY_CUENTA_SERVICIO=
# Audiencia del token de los envíos de Cloud Pub/Sub (la URL del webhook de Google Play).
GOOGLE_PLAY_PUBSUB_AUDIENCIA=
APP_STORE_BUNDLE_ID=cl.superapaes.app
APP_STORE_ID_EMISOR=
APP_STORE_ID_CLAVE=
# Contenido de la clave privada .p8 de la App Store Server API.
APP_STORE_CLAVE_PRIVADA=
# sandbox | produccion
APP_STORE_ENTORNO=sandbox
