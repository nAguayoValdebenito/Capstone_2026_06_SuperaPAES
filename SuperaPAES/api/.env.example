# Copia este archivo como api/.env y completa los valores. Nunca subas api/.env al repositorio.
# Con NODE_ENV=production la API no arranca con proveedores de desarrollo: exige
# PROVEEDOR_IA=deepseek|gemini, PROVEEDOR_CORREO=smtp y PROVEEDOR_PAGOS=tiendas.
# Con todos los proveedores en simulado/consola, la API arranca solo con DATABASE_URL, los dos
# secretos JWT y PORT. Los parámetros de negocio (cupos, bonos, topes, plazos) no van aquí:
# viven en la tabla contenido.configuracion.

NODE_ENV=development
PORT=3000

# PostgreSQL 18 instalado en el equipo, puerto 5432.
# Valor de ejemplo (CAMBIAR por la clave de tu PostgreSQL local). secretlint-disable-next-line
DATABASE_URL=postgres://postgres:CAMBIAR@localhost:5432/supera_paes
# true en Neon u otro servicio con TLS.
DATABASE_SSL=false
# Base aparte para las pruebas con PostgreSQL (npm run test -w api las activa si esta variable existe).
# Su nombre DEBE terminar en _test: las pruebas se niegan a vaciar o borrar cualquier otra base. Se crea
# y migra una vez (ver docs/arquitectura.md, «Pruebas con PostgreSQL»). Valor de ejemplo, CAMBIAR la
# clave. secretlint-disable-next-line
DATABASE_URL_PRUEBAS=postgres://postgres:CAMBIAR@localhost:5432/supera_paes_test
# Semillas que npm run semillas y migrar:produccion no cargan, separadas por comas. En la base
# publicada: 003_documentos_legales.sql, hasta que un docente o el cliente revise el texto (RN-30).
# SEMILLAS_OMITIDAS=003_documentos_legales.sql

# Orígenes permitidos (solo la consola web; la app móvil no usa CORS), separados por comas.
CORS_ORIGENES=http://localhost:5173

# Secretos distintos, de al menos 32 caracteres. Genera cada uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO_CONSOLA=
JWT_SECRETO_APP=

# Dirección pública de la consola (sin / final). Los correos de verificación enlazan a
# <URL_CONSOLA>/verificar-correo?token=... Su origen debe estar en CORS_ORIGENES; en producción, https.
URL_CONSOLA=http://localhost:5173
# Clave del HMAC-SHA-256 que protege el código de 6 dígitos del correo de verificación (RN-32).
# Al menos 32 caracteres y distinta de los secretos JWT; se genera igual que ellos. Cambiarla deja sin
# uso los códigos pendientes: el estudiante pide un correo nuevo (ver docs/despliegue.md).
CLAVE_CODIGO_CORREO=CAMBIAR

# IA: simulado | deepseek | gemini. Las claves quedan solo en el servidor.
PROVEEDOR_IA=simulado
DEEPSEEK_API_KEY=
# Con DeepSeek, completar Gemini habilita respaldo exclusivamente ante HTTP 402 (sin saldo).
GEMINI_API_KEY=
# Obligatorio con Gemini directo o respaldo. El modelo DeepSeek se lee de contenido.configuracion.
GEMINI_MODELO=gemini-3.5-flash-lite

# Correo: consola (no envía nada) | smtp. Con consola, las variables SMTP pueden quedar vacías.
# Mailpit usa localhost:1025 sin TLS ni credenciales. Un servidor remoto exige TLS y credenciales.
# SMTP_TLS: implicit (465) | starttls (587 o 2525) | none (solo localhost).
PROVEEDOR_CORREO=consola
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USUARIO=
# Clave SMTP del proveedor; no es la contraseña de la cuenta ni una clave de API.
SMTP_CLAVE=
# Solo la dirección verificada; la API agrega el nombre visible «Supera PAES».
CORREO_REMITENTE=
# Timeout común de conexión, saludo e inactividad durante el envío (100 a 60000 ms).
SMTP_TIMEOUT_MS=10000

# Pagos: simulado (desarrollo y pruebas) | tiendas (Google Play Billing y App Store).
# Con tiendas, todas las variables siguientes son obligatorias.
PROVEEDOR_PAGOS=simulado
GOOGLE_PLAY_PAQUETE=cl.superapaes.app
# Ruta del archivo o contenido JSON de la cuenta de servicio de la Google Play Developer API.
GOOGLE_PLAY_CUENTA_SERVICIO=
# Audiencia del token de los envíos de Cloud Pub/Sub (la URL del webhook de Google Play).
GOOGLE_PLAY_PUBSUB_AUDIENCIA=
APP_STORE_BUNDLE_ID=cl.superapaes.app
APP_STORE_ID_EMISOR=
APP_STORE_ID_CLAVE=
# Contenido de la clave privada .p8 de la App Store Server API.
APP_STORE_CLAVE_PRIVADA=
# sandbox | produccion
APP_STORE_ENTORNO=sandbox
