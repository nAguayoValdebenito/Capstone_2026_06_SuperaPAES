{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "servidor.ts",
    "app.ts",
    "modulos",
    "comun",
    "adaptadores",
    "trabajos",
    "db",
    "scripts",
    "pruebas",
    "vitest.config.ts",
    "eslint.config.js",
    "eslint.reglas-arquitectura.js"
  ]
}
