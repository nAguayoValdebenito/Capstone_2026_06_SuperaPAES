# Copia este archivo a .env.docker. Completa los cuatro secretos antes de levantar los servicios.
# No subas .env.docker. Usa una contraseña URL-safe para PostgreSQL (por ejemplo, base64url).
POSTGRES_PASSWORD=
PUERTO_POSTGRES_LOCAL=5433
PUERTO_MAILPIT_LOCAL=8025
DATABASE_URL=postgres://supera:${POSTGRES_PASSWORD}@db:5432/supera_paes

# Docker Compose fija NODE_ENV=development para conservar los proveedores locales.
NODE_ENV=development
PORT=3000
DATABASE_SSL=false
JWT_SECRETO_CONSOLA=
JWT_SECRETO_APP=
CLAVE_CODIGO_CORREO=
CORS_ORIGENES=http://localhost:8080
URL_CONSOLA=http://localhost:8080
PROVEEDOR_IA=simulado
# Las claves vacías conservan la ejecución local sin red hacia proveedores de IA.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite
PROVEEDOR_CORREO=consola
# SMTP queda desactivado mientras el proveedor sea consola. Para ver los correos en Mailpit
# (http://localhost:8025) usa PROVEEDOR_CORREO=smtp, SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_TLS=none
# y deja usuario y clave vacíos. Nunca guardes aquí credenciales de un servidor real.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=
SMTP_TIMEOUT_MS=10000
# Opcional: clave de la ruta de tareas periódicas (32 caracteres o más, distinta de los demás secretos).
CLAVE_TAREAS=
PROVEEDOR_PAGOS=simulado
# Modo de pruebas de suscripción: true crea suscripciones simuladas para verlas en la consola (sin tiendas ni pagos).
MODO_PRUEBAS_SUSCRIPCION=false
# Modo de pruebas de preguntas: true permite publicar sin revisión hasta 10 borradores por clic desde la consola.
MODO_PRUEBAS_PREGUNTAS=false
SEMILLAS_OMITIDAS=

# Vite inserta esta URL pública en los archivos de la consola; nunca coloques secretos VITE_.
VITE_API_URL=http://localhost:3000
